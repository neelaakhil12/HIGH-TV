generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}



// ── All CMS news articles (custom + static overrides) ──────────────────────
model Article {
  id           String   @id @default(cuid())
  title        String   @db.Text
  slug         String   @unique @db.VarChar(500)
  categorySlug String   @db.VarChar(100)
  districtSlug String?  @db.VarChar(100)
  category     String?  @db.VarChar(100)
  author       String   @default("హై టీవీ డెస్క్") @db.VarChar(200)
  publishedAt  DateTime @default(now())
  description     String?  @db.Text
  metaDescription String?  @db.Text
  body            String?  @db.LongText
  image           String?  @db.LongText
  tags            Tag[]
  views           Int      @default(0)
  isBreaking      Boolean  @default(false)
  isTrending   Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categorySlug])
  @@index([isBreaking])
  @@index([isTrending])
  @@index([isFeatured])
  @@index([publishedAt])
}

// ── Flash News Ticker scrolling items ──────────────────────────────────────
model FlashNews {
  id        Int      @id @default(autoincrement())
  text      String   @db.Text
  link      String   @db.VarChar(500)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ── Trending News Ticker rotating headlines ────────────────────────────────
model TrendingNews {
  id        Int      @id @default(autoincrement())
  text      String   @db.Text
  link      String   @db.VarChar(500)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ── Homepage Hero Banner Slides ────────────────────────────────────────────
model BannerSlide {
  id        Int      @id @default(autoincrement())
  title     String   @db.Text
  image     String   @db.LongText
  link      String?  @db.VarChar(500)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ── E-Paper PDF Editions ───────────────────────────────────────────────────
model Epaper {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(500)
  date      String   @db.VarChar(20)
  pdfUrl    String   @db.LongText
  section   String   @default("main") @db.VarChar(100)
  createdAt DateTime @default(now())
}

// ── Admin Session (optional – for server-side auth later) ─────────────────
model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EpaperSection {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  key       String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
}

model LatestVideo {
  id        Int      @id @default(autoincrement())
  youtubeId String   @db.VarChar(500)
  title     String   @db.Text
  thumbnail String   @db.LongText
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id @db.VarChar(255)
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(100)
  articles  Article[]
  createdAt DateTime  @default(now())
}
